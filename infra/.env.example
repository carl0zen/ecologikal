# Copy to infra/.env for compose (optional). Demo defaults are safe for local only.

JWT_SECRET=development-only-secret-change-me
SSO_SECRET=development-only-secret-change-me
CERTEXI_PLATFORM_URL=http://host.docker.internal:3000

# HTTP gateway demo: leave false. Set true only behind real TLS.
ECO_COOKIE_SECURE=false
ECO_ALLOW_DEV_LOGIN=true
ECO_ALLOW_PROOF_STUB=true

ECO_NEXTCLOUD_URL=http://localhost:8081
ECO_NEXTCLOUD_ADMIN_USER=ecoadmin
ECO_NEXTCLOUD_ADMIN_PASSWORD=ecoadmin-change-me
